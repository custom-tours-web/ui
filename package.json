{
  "name": "custom-tours-web-ui",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "test:contract": "vitest run tests/contract",
    "test:component": "vitest run tests/components",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "npm run e2e:build && playwright test",
    "e2e:build": "node tests/e2e/build.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:component": "vitest run --config vitest.component-coverage.config.ts --coverage tests/components",
    "test:coverage:integration": "vitest run --config vitest.integration-coverage.config.ts --coverage tests/integration",
    "test:coverage:contract": "vitest run --config vitest.contract-coverage.config.ts --coverage tests/contract",
    "test:mutation": "stryker run"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^26.6.4",
    "@vitest/coverage-v8": "^5.0.3",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-reports": "^3.2.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.55.0",
    "stylus": "^0.64.0",
    "typescript": "^5.9.3",
    "v8-to-istanbul": "^9.3.0",
    "vite": "^7.1.7",
    "vitest": "^5.0.3"
  }
}
